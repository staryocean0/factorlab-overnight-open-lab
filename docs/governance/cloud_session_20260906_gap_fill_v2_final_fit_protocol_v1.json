      "target": "fill_60m"
    },
    "eod": {
      "risk_set": "rows_not_filled_by_60m",
      "target": "fill_eod"
    }
  },
  "fixed_estimator": {
    "pipeline": "StandardScaler + LogisticRegression",
    "StandardScaler": {
      "with_mean": true,
      "with_std": true
    },
    "LogisticRegression": {
      "penalty": "l2",
      "C": 1.0,
      "solver": "lbfgs",
      "class_weight": null,
      "max_iter": 1000,
      "fit_intercept": true
    },
    "probability_calibration": "none",
    "binary_threshold": null
  },
  "cumulative_probability_contract": {
    "p15": "h15",
    "p60": "1-(1-h15)*(1-h60)",
    "pEOD": "1-(1-h15)*(1-h60)*(1-hEOD)",
    "required_invariant": "0<=p15<=p60<=pEOD<=1"
