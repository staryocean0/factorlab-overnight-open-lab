{
  "schema_id": "factorlab_reversal_mean_reversion_common_measurement_contract@1.0",
  "session_date": "2026-09-08",
  "program_identity": "broad_reversal_mean_reversion_discovery_program_v1",
  "stage": "stage0_results_blind_common_measurement_freeze",
  "purpose": "give_R1_R2_R3_a_common_causal_language_without_forcing_one_mean_definition_or_one_strategy",
  "market_outcomes_opened_for_this_contract": false,
  "common_coordinates": {
    "scale": {
      "required_roles": ["lower", "current", "parent"],
      "rule": "all_roles_must_be_defined_before_outcome_inspection_and_must_not_be_inferred_from_future_turning_points",
      "preferred_first_pass_views": [
        "physical_time_bar_view",
        "event_based_completed_wave_view"
      ]
    },
    "parent_state": {
      "allowed_labels_for_reporting": ["trend_up", "trend_down", "range_like", "transition_or_uncertain"],
      "stage1_primary_representation": "continuous_scores_before_any_hard_threshold",
      "continuous_scores": [
        "two_completed_wave_signed_drift_ratio",
        "two_completed_wave_overlap_ratio",
        "parent_path_efficiency",
        "short_to_parent_volatility_ratio"
      ],
      "causal_rule": "parent_state_at_event_time_may_use_only_completed_parent_information_and_information_available_at_event_detection"
    },
    "deviation": {
      "must_identify_object": ["price", "path", "wave", "distribution", "relative_relationship", "statistical_property"],
      "stage1_normalization": [
        "pre_event_volatility_units",
        "parent_or_range_width_units",
        "event_wave_amplitude_units"
      ],
      "absolute_price_threshold_search_forbidden": true
    },
    "recovery": {
      "primary_principle": "use_structure_or_symmetric_first_passage_when_possible_instead_of_optimizing_a_return_horizon",
      "must_define_before_outcome_open": [
        "recovery_boundary",
        "failure_or_state_change_boundary",
        "maximum_observation_horizon",
        "tie_and_missing_data_rule"
      ],
      "time_to_event_report_required": true
    }
  },
  "completed_wave_measurement": {
    "concept": "a_wave_is_only_available_after_a_causal_reversal_confirmation_rule_marks_the_previous_extreme_as_completed",
    "future_extreme_lookahead_forbidden": true,
    "stage1_threshold_policy": "do_not_optimize_wave_threshold_on_trading_return; if_multiple_thresholds_are_needed_use_a_small_predeclared_scale_set_and_treat_each_as_a_measurement_scale_not_a_candidate_strategy",
    "two_wave_parent_state_scores": {
      "signed_drift_ratio": "signed(end_of_wave2-start_of_wave1)/(abs(move_wave1)+abs(move_wave2))",
      "absolute_drift_ratio": "abs(end_of_wave2-start_of_wave1)/(abs(move_wave1)+abs(move_wave2))",
      "overlap_ratio": "price_interval_overlap_of_two_completed_waves/min(interval_width_wave1,interval_width_wave2)",
      "path_efficiency": "abs(end_of_wave2-start_of_wave1)/sum_abs_bar_or_event_moves_across_the_two_wave_path"
    },
    "interpretation_only_not_hard_rule": {
      "trend_like": "larger_absolute_drift_and_lower_overlap",
      "range_like": "smaller_absolute_drift_and_higher_overlap"
    }
  },
  "common_stage1_reporting": {
    "no_strategy_pnl_required": true,
    "required": [
      "event_count",
      "recovery_probability_or_first_passage_share",
      "effect_size_between_predeclared_state_buckets_or_continuous_score_slope",
      "time_to_recovery_distribution",
      "chronological_stability",
      "scale_sensitivity",
      "missing_data_and_event_overlap_counts"
    ],
    "optional_diagnostics": [
      "Brier_score_for_a_predeclared_low_capacity_probability_model",
      "AUC_or_rank_metric_as_descriptive_only",
      "path_visualization_for_failure_morphology"
    ]
  },
  "common_stage1_scientific_questions": [
    "does_conditioning_on_parent_state_change_the_reversion_probability_materially",
    "is_the_condition_observable_before_recovery_or_failure",
    "does_the_effect_keep_the_same_direction_across_multiple_time_blocks_or_scales",
    "does_a_low_capacity_measurement_explain_the_effect_without_threshold_hunting"
  ],
  "forbidden_stage1_behaviors": [
    "optimize_trading_return",
    "search_many_wave_thresholds",
    "search_many_horizons",
    "add_posthoc_regime_labels_after_failure",
    "use_future_turning_points_to_label_parent_state_at_event_time",
    "promote_a_lane_from_one_period_or_one_scale_only",
    "reuse_legacy_sealed_outcomes_as_new_lane_design_material"
  ],
  "production_authority": false
}
