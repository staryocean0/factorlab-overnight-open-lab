  "exact_clocks_required": ["09:31", "09:35", "10:05", "10:35", "14:00", "15:00"],
  "definitions": {
    "gap": "open_0931 / previous_close_1500 - 1",
    "r1": "close_1500.shift(1) / close_1500.shift(2) - 1",
    "r20": "close_1500.shift(1) / close_1500.shift(21) - 1",
    "rvol20": "std(close_1500.pct_change().shift(1), window=20, min_periods=20)",
    "prev_daytime": "(close_1500 / open_0931 - 1).shift(1)",
    "prev_last_hour": "(close_1500 / close_1400 - 1).shift(1)",
    "holiday_reopen": "1 if calendar_days_since_previous_trading_day >= 4 else 0",
    "observed_gap_rvol": "gap / rvol20",
    "last_hour_rvol": "prev_last_hour / rvol20",
    "trend20_rvol": "r20 / (sqrt(20) * rvol20)",
    "trend_gap_interaction": "observed_gap_rvol * trend20_rvol",
    "log_rvol20": "log(rvol20)",
    "last_hour_gap_interaction": "last_hour_rvol * observed_gap_rvol"
  },
  "baseline_controls": [
    "observed_gap_rvol",
    "last_hour_rvol",
    "prev_daytime",
    "trend20_rvol",
    "trend_gap_interaction",
    "log_rvol20",
    "r1",
    "holiday_reopen"
  ],
  "candidate_increment": ["last_hour_gap_interaction"],
  "frozen_direction": "positive",
  "targets": [
    {"id": "ret_0935_1005", "start_clock": "09:35", "end_clock": "10:05"},
    {"id": "ret_0935_1035", "start_clock": "09:35", "end_clock": "10:35"}
